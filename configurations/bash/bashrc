#!/usr/bin/env bash
# ~/.bashrc — minimal stub. Every customization lives in
# ${DOTFILES_DIR}/.load (gitignored, per-host). See
# scripts/init-load for the template that generates .load.

# If not running interactively, don't do anything (system default guard).
case $- in
    *i*) ;;
    *) return ;;
esac

export DOTFILES_DIR="${DOTFILES_DIR:-${HOME}/gel-ort/dotfiles}"
# shellcheck disable=SC1091  # generated, gitignored
[ -r "${DOTFILES_DIR}/.load" ] && . "${DOTFILES_DIR}/.load"
