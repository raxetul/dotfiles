#!/usr/bin/env bash
# ~/.bashrc — minimal stub. Every customization lives in
# $HOME/.dotfiles/load (per-user, one per account — NOT inside the
# shared repo, which may be root:dotfiles-owned at /opt/dotfiles). See
# scripts/init-load for the template that generates it.

# If not running interactively, don't do anything (system default guard).
case $- in
    *i*) ;;
    *) return ;;
esac

# DOTFILES_DIR resolution inlined from scripts/dotfiles-dir.sh: this is
# the one place that can't source it, since nothing is known yet about
# where the repo lives. Keep the two in sync by hand.
if [ -z "${DOTFILES_DIR:-}" ]; then
    if [ -d /opt/dotfiles ]; then
        DOTFILES_DIR=/opt/dotfiles
    else
        DOTFILES_DIR="${HOME}/gel-ort/dotfiles"
    fi
fi
export DOTFILES_DIR

# $HOME/.dotfiles/load is current; ${DOTFILES_DIR}/.load is the legacy
# in-repo location (pre-/opt/dotfiles installs) — read as a fallback so
# an existing live install keeps working until it migrates.
# shellcheck disable=SC1091  # generated, per-user
if [ -r "${HOME}/.dotfiles/load" ]; then
    . "${HOME}/.dotfiles/load"
elif [ -r "${DOTFILES_DIR}/.load" ]; then
    . "${DOTFILES_DIR}/.load"
fi
