# apt.list — Debian / Ubuntu / Mint baseline (server + CLI).
# One package per line; blank lines and lines starting with # are skipped.
# setup.sh runs `sudo apt install -y` on every non-comment line.
#
# Desktop additions live in apt-desktop.list. Packages absent from apt
# repos (starship, atuin, rustup, lefthook, tealdeer, bandwhich, ghostty,
# discord, veracrypt, JetBrains Mono Nerd Font) fall through to either
# snap.list or a release-binary bootstrap in setup.sh.
#
# Source of truth for the apt column of doc/packages-native.md. Keep
# the two in lockstep (CLAUDE.md §6).

# Shell + prompt
zsh
zsh-autosuggestions
zsh-syntax-highlighting

# File / search tools
eza
bat
fzf
ripgrep
fd-find
zoxide
tldr
jq

# Editor stack
vim
neovim
tmux

# Git + dev tooling
git
git-delta
gnupg
pinentry-curses
shellcheck

# Language toolchains
golang-go
nodejs
llvm
clang-format
clang-tidy

# Networking / sysadmin
arp-scan
dnsutils
wget
curl

# Containers
# Debian ships docker.io (engine) but not docker-compose-v2. Compose v2
# requires Docker's official APT repo (download.docker.com); without it,
# the `docker-compose-plugin` line below will fail apt — comment it out
# until you've added the repo, then re-run setup.sh.
#
# Quick setup of Docker's official repo on Debian:
#   sudo install -m 0755 -d /etc/apt/keyrings
#   curl -fsSL https://download.docker.com/linux/debian/gpg | \
#       sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg
#   echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
#       https://download.docker.com/linux/debian $(lsb_release -cs) stable" | \
#       sudo tee /etc/apt/sources.list.d/docker.list
#   sudo apt-get update
docker.io
docker-compose-plugin

# VM / virtualization (comment out if you don't need libvirt/qemu)
libvirt-daemon-system
qemu-kvm

# Filesystem / misc
sqlite3
zip
unzip
asciinema

# Fonts
fonts-font-awesome
fonts-jetbrains-mono
