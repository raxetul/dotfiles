# Brewfile — every package installed on macOS. setup.sh runs `brew bundle`
# against this file on every invocation; idempotent.
#
# Source of truth for the macOS column of doc/packages-native.md. Keep
# the two in lockstep (CLAUDE.md §6).

# === Shell + prompt ===
brew "zsh"
brew "starship"
brew "atuin"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-history-substring-search"

# === File / search tools ===
brew "eza"
brew "bat"
brew "fzf"
brew "ripgrep"
brew "fd"
brew "zoxide"
brew "tealdeer"            # tldr client
brew "jq"

# === Editor stack ===
brew "vim"
brew "neovim"
brew "tmux"

# === Git + dev tooling ===
brew "git"
brew "git-delta"
brew "gnupg"
brew "pinentry-mac"        # Cocoa pinentry, wired in configurations/gpg/gpg-agent.conf.darwin
brew "lefthook"
brew "shellcheck"
brew "gh"                 # GitHub CLI
brew "herdr"               # agent multiplexer; Linux has no native pkg -> packages/script-install.list

# === Language toolchains ===
brew "go"
brew "rustup-init"
brew "node"
brew "llvm"
brew "clang-format"
# `mold` is omitted on macOS — it links ELF only; Rust on Darwin uses
# the system linker (lld via Xcode). See packages-native.md.

# === Networking / sysadmin ===
brew "arp-scan"
brew "bandwhich"
brew "bind"                # provides dig, host, nslookup
brew "wget"
brew "curl"

# === Containers (CLI; daemon via colima) ===
brew "docker"
brew "docker-compose"
brew "colima"
brew "lima"

# === Filesystem / misc ===
brew "sqlite"
brew "coreutils"           # GNU coreutils, prefixed with `g` (gdate, gsed, …)
brew "zip"
brew "unzip"
brew "asciinema"

# === AI / LLM tooling ===
# opencode has no homebrew-core formula; anomalyco/tap is the only tap that
# builds it (sst/tap mirrors the same github.com/anomalyco/opencode release
# artifacts — same lineage, same untrusted-tap gate, no advantage over tapping
# anomalyco/tap directly). The tap + trust step run in
# custom-install/opencode/before.sh, BEFORE this line is reached.
tap "anomalyco/tap"
brew "anomalyco/tap/opencode"
brew "ollama"              # core formula; custom-install/ollama/{before,after}.sh
                            # migrate this Mac off the upstream .app installer

# === Fonts ===
cask "font-fontawesome"
cask "font-jetbrains-mono"
cask "font-jetbrains-mono-nerd-font"

# === GUI casks ===

# Terminal — official Darwin build from Mitchell Hashimoto.
cask "ghostty"

# Window management + key remapping
cask "karabiner-elements"
cask "rectangle"

# Communications
cask "discord"
cask "telegram"

# Media + recording
cask "obs"
cask "flameshot"

# Dev tooling
cask "qt-creator"
cask "kdiff3"

# Disk / encryption
cask "veracrypt"
