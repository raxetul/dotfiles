# dnf-desktop.list — Fedora / RHEL / CentOS / Rocky / Alma desktop add-ons.
# Installed by setup.sh only when --desktop is passed.
#
# discord and veracrypt fall through to RPM Fusion or snap.list.
# ghostty falls through to COPR `pgdev/ghostty` (handled in setup.sh).

# Wayland / window stack
sway
swaybg
swayidle
swaylock
waybar
wofi
dunst
xdotool

# GUI apps
flameshot
kdiff3
nautilus
obs-studio
smplayer
qt-creator

# Tauri / GTK desktop-app build dependencies (Fedora equivalents of the Tauri
# v2 Debian set). The C toolchain comes from the "Development Tools"/"C
# Development Tools and Libraries" groups — install those separately with
# `dnf group install` if not already present.
# VERIFY the appindicator name on your box — Fedora has shipped both
# `libayatana-appindicator-gtk3-devel` and the older `libappindicator-gtk3-devel`.
file
webkit2gtk4.1-devel
libxdo-devel
openssl-devel
libayatana-appindicator-gtk3-devel
librsvg2-devel
