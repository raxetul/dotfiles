# apt-desktop.list — Debian / Ubuntu / Mint desktop additions.
# Installed by setup.sh only when --desktop is passed.
#
# Packages absent here that v3 still wants (ghostty, discord, veracrypt)
# fall through to snap.list or a release-binary bootstrap in setup.sh.

# Wayland / window stack
sway
swaybg
swayidle
swaylock
waybar
wofi
dunst
xdotool

# GUI apps
flameshot
kdiff3
nautilus
obs-studio
smplayer
qtcreator

# Tauri / GTK desktop-app build dependencies
# Matches Tauri v2's official Debian prerequisites. curl + wget are already
# in the baseline apt.list, so they are not repeated here.
build-essential
file
libwebkit2gtk-4.1-dev
libxdo-dev
libssl-dev
libayatana-appindicator3-dev
librsvg2-dev
