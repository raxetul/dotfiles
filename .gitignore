.direnv/
result
result-*
.DS_Store
*.swp
.history
.installed

# Legacy per-host shell init centre. Current location is $HOME/.dotfiles/
# (load, path — outside the repo entirely, so no ignore entry needed
# there). These repo-root names are only read as a fallback by hosts
# that haven't run scripts/migrate-to-opt.sh yet; ignored here in case
# one still exists.
.load
.path

# Skills live in the remote-less global repo (${AGENT_SKILLS_DIR}), never
# in a project repo. See doc/agent-skills.md.
configurations/claude/skills/
.claude/skills/

# leak-guard's private pattern file. Holds the employer name, private repo
# names and internal service hostnames — i.e. exactly the strings that must
# never reach this PUBLIC repo. Created by `scripts/leak-guard init-private`.
.leak-guard-patterns
.temp_files/

.wrongstack/
!/.wrongstack/
/.wrongstack/*
!/.wrongstack/project.json
