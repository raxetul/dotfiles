#!/usr/bin/env bash
# claude-worktree — spin up a git worktree + a parallel Claude session in herdr.
#
# Each parallel Claude runs on its own branch in its own *worktree* (a second
# checkout that shares this repo's single .git), so sessions never fight over
# the working tree. Sessions are arranged as a TEAM inside the current tab: the
# pane you launch from is the team LEADER on the left; every new session joins
# as a team MEMBER stacked vertically down the right-hand column.
#
#     +-----------+-----------+
#     |           | member 1  |
#     |  leader   +-----------+
#     |  (left)   | member 2  |
#     |           +-----------+
#     |           | member 3  |
#     +-----------+-----------+
#
# The first member splits the leader to the right (opening the column); each
# later member splits down off the bottom of that column. Placement is found by
# walking herdr's pane graph, so it works no matter which pane you run from.
#
# Worktrees live as siblings of the main checkout:
#     ../<repo>.worktrees/<branch>          (branch slashes → "-")
#
# Usage:
#   claude-worktree <branch> [--base <ref>] [--role <name>] [--tab]
#                            [--split right|down]
#                            [--focus-member] [--no-focus] [--no-claude]
#                            [-- <extra claude args>]
#   claude-worktree list
#   claude-worktree rm <branch> [--force]
#
# Placement:
#   (default)       team layout — leader left, members stacked down the right column.
#   --tab           put the member in its own new tab instead of the column.
#   --split D       override: plain split (right|down) off the current pane.
#
# Naming (herdr agent name + pane label — NOT the worktree path, which always
# keys off the branch slug so `list`/`rm` keep working):
#   --role <name>   logical function this member does — frontend / backend /
#                   embedded / documentor / tooling / infra / test / ... (free
#                   text, kebab-case). Allocated via `herdr-team name <role>`:
#                   the role itself if free, else <role>-<mascot>, else
#                   <role>-N. See doc/claude-worktrees.md for the mascot pool.
#   (omitted)       falls back to the branch slug, WITH a one-line warning —
#                   never silently.
#
# Focus (where the cursor lands after launch):
#   (default)       the team LEADER keeps focus — orchestrate from the left.
#   --focus-member  jump to the newly spawned member instead.
#   --no-focus      leave focus on the pane you launched from.
#
# Examples:
#   claude-worktree feature-x --role frontend  # new member, pane labelled "frontend"
#   claude-worktree hotfix --base main --tab   # from main, in its own tab
#   claude-worktree review-pr-42 --no-claude   # just make the worktree; start claude myself
#
# herdr is used only to PLACE the session; the worktree itself is plain git, so
# --no-claude / a herdr-less shell still get a usable worktree.
set -euo pipefail

die() { printf 'claude-worktree: %s\n' "$*" >&2; exit 1; }

git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
  || die "not inside a git repository"

# main checkout = first worktree git reports; siblings hang next to it
main_wt="$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}')"
repo="$(basename "$main_wt")"
wt_base="$(dirname "$main_wt")/${repo}.worktrees"

slug() { printf '%s' "${1//\//-}"; }             # branch -> filesystem-safe dir

# ---------------------------------------------------------------------------
# subcommands: list / rm
# ---------------------------------------------------------------------------
case "${1:-}" in
  ""|-h|--help)
    sed -n '2,59p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  list)
    git worktree list; exit 0 ;;
  rm)
    [ $# -ge 2 ] || die "rm needs a <branch>"
    force=""; [ "${3:-}" = "--force" ] && force="--force"
    wt_path="$wt_base/$(slug "$2")"
    git worktree remove $force "$wt_path"
    printf 'removed worktree %s (branch "%s" kept; delete it with: git branch -d %s)\n' \
      "$wt_path" "$2" "$2"
    exit 0 ;;
esac

# ---------------------------------------------------------------------------
# create
# ---------------------------------------------------------------------------
branch="$1"; shift
case "$branch" in -*) die "first argument must be a branch name, got: $branch";; esac

base="HEAD"; launch=1; focus_mode="leader"         # team default: focus stays on the leader
mode="team"; split_dir="right"                     # default: team layout (leader + column)
role=""                                            # logical function; empty -> branch-slug fallback
extra=()
while [ $# -gt 0 ]; do
  case "$1" in
    --base)         base="${2:?--base needs a ref}"; shift 2 ;;
    --role)         role="${2:?--role needs a name}"; shift 2 ;;
    --tab)          mode="tab"; shift ;;
    --split)        mode="manual"; split_dir="${2:-right}"; shift 2 ;;
    --focus-member) focus_mode="member"; shift ;;
    --no-focus)     focus_mode="none"; shift ;;
    --no-claude)    launch=0; shift ;;
    --)             shift; extra=("$@"); break ;;
    *)              die "unknown option: $1" ;;
  esac
done

case "$role" in
  '') : ;;
  *[!a-z0-9-]*) die "--role must be short kebab-case (lowercase letters, digits, hyphens): $role" ;;
esac

wt_path="$wt_base/$(slug "$branch")"
mkdir -p "$wt_base"

if git worktree list --porcelain | grep -qxF "worktree $wt_path"; then
  printf 'reusing existing worktree %s\n' "$wt_path"
elif git show-ref --verify --quiet "refs/heads/$branch"; then
  git worktree add "$wt_path" "$branch"            # existing branch
else
  git worktree add -b "$branch" "$wt_path" "$base" # new branch from base
fi

[ "$launch" = 1 ] || { printf 'worktree ready: %s\n' "$wt_path"; exit 0; }

if [ -z "${HERDR_ENV:-}" ] || ! command -v herdr >/dev/null 2>&1; then
  printf 'herdr not active — worktree ready at %s\n  cd %q && claude\n' "$wt_path" "$wt_path"
  exit 0
fi

# --- herdr pane-geometry helpers ---------------------------------------------
cur_pane() { herdr pane current | jq -r '.result.pane.pane_id // empty'; }

# The invoking pane IS the lead dispatching this member, and herdr exports its
# identity into every pane's shell (HERDR_PANE_ID/TAB/WORKSPACE). Trust that
# over `herdr pane current` / `--current`, which resolve against GLOBAL focus:
# at spawn time focus may sit in a totally different project's workspace, and
# splitting relative to it drops the member into the wrong project — exactly the
# "panes of one project in another's workspace" leak. Anchoring every placement
# to the lead's own workspace makes cross-project contamination impossible.
lead_pane="${HERDR_PANE_ID:-$(cur_pane)}"
lead_ws="${HERDR_WORKSPACE_ID:-}"
# The team layout is read from pane RECTANGLES: `herdr pane layout --pane
# "$lead_pane"` lists every pane in the LEAD's tab with its {x,y,w,h} (scoped
# to the lead, not global focus, so members stay in this project). (herdr's `pane
# neighbor` reports focus-movement targets, not spatial adjacency, so it can't
# be walked.) leader = leftmost pane (min x); right column = panes to its right
# (x > leader.x); the column's bottom pane = the one with the greatest y.
# Every pane this script creates is created --no-focus; focus is landed once, at
# the very end, per --focus-member / --no-focus / (default) leader. Under herdr
# 0.9.0 each split is anchored with an explicit --pane, so placement no longer
# depends on which pane happens to hold focus at the time — the old
# focus-then-split-off-focus dance is gone.
member_pane=""
# herdr requires a UNIQUE agent name per workspace. Prefer a ROLE-based name
# (frontend/backend/embedded/documentor/...) over the branch slug so panes read
# as "what is this member doing" rather than "which branch is it on" — the
# worktree PATH above still keys off the branch slug (unaffected by --role),
# only the herdr agent name / pane label change. Allocation (role -> role-mascot
# -> role-N on collision) lives in ONE place, `herdr-team name`, so this script
# and herdr-team never disagree on the next free name.
if [ -n "$role" ]; then
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  label="$("$script_dir/herdr-team" name "$role")"
else
  label="$(slug "$branch")"
  printf 'claude-worktree: no --role given — falling back to branch-slug agent name %s (pass --role <name> for a readable pane label)\n' \
    "$label" >&2
fi
# herdr 0.9.0 split `agent start` in two: it no longer creates, splits or moves
# anything, and has no --cwd/--split/--workspace/--tab of its own. It ATTACHES a
# named agent to an ALREADY-EXISTING shell pane:
#
#   0.7.1:  agent start <name> --cwd P --workspace W --split right -- claude
#   0.9.0:  pane split --pane <anchor> --direction right --cwd P --no-focus
#           agent start <name> --kind claude --pane <the new pane id> -- <args>
#
# That is strictly safer for this script's purpose: a pane id is already
# workspace-qualified ("w3:p4"), so anchoring the split to the LEAD's own pane
# pins the member to the lead's workspace by construction — the cross-project
# leak the old --workspace pin existed to prevent is now structural.
#
# Two more 0.9.0 details that are easy to get wrong, because failing either one
# leaves a pane sitting at a plain shell prompt with no agent in it:
#   * `--kind <agent>` is REQUIRED — herdr exits `missing required --kind`.
#   * everything after `--` is the AGENT's own argv, NOT a command line: herdr
#     supplies the `claude` binary itself from --kind. Passing `-- claude …`
#     the 0.7.1 way makes herdr run `claude claude …`.
#
# attach_member <pane-id> — start claude in an existing pane and label it.
attach_member() {
  local pane_id="$1" err
  member_pane="$pane_id"
  # `agent start` returns only once herdr sees the agent ready; a trust prompt
  # ("do you trust this folder", which every fresh worktree path raises) or a
  # slow start makes it return agent_not_ready while the pane is perfectly fine.
  # Warn with herdr's own message — never abort — the member is live and the
  # human just has to answer it.
  if ! err="$(herdr agent start "$label" --kind claude --pane "$pane_id" \
              -- ${extra[@]+"${extra[@]}"} 2>&1 >/dev/null)"; then
    printf 'claude-worktree: herdr did not report agent "%s" ready in %s%s\n  check it with: herdr pane read %s\n' \
      "$label" "$pane_id" "${err:+ — $err}" "$pane_id" >&2
  fi
  # Relabel the pane so the border reads "frontend"/"frontend-haro" rather than
  # a raw pane id. Cosmetic only — never fatal.
  herdr pane rename "$pane_id" "$label" >/dev/null 2>&1 || true
  return 0
}
# start_member <anchor-pane> <split-direction> — open a pane next to <anchor>
# in the worktree, then attach the member to it.
start_member() {
  local anchor="$1" dir="$2" pane_id
  pane_id="$(herdr pane split --pane "$anchor" --direction "$dir" --cwd "$wt_path" \
             --no-focus 2>/dev/null | jq -r '.result.pane.pane_id // empty' 2>/dev/null)"
  [ -n "$pane_id" ] \
    || die "herdr pane split off $anchor returned no pane id — member not started. The worktree is ready at $wt_path; start it by hand with: cd $wt_path && claude"
  attach_member "$pane_id"
}

origin="$lead_pane"                                # the lead pane dispatching this member
leader=""

case "$mode" in
  manual)
    # power-user override: plain split off the LEAD's own pane
    start_member "$lead_pane" "$split_dir" ;;
  tab)
    # Member in its own new tab, labelled with the branch. `tab create` opens
    # the tab WITH one shell pane already in it (reported as .result.root_pane),
    # at the --cwd given, so there is nothing to split — attach straight to it.
    tab_json="$(herdr tab create ${lead_ws:+--workspace "$lead_ws"} --cwd "$wt_path" \
                --label "$branch" --no-focus 2>/dev/null || true)"
    tab_pane="$(printf '%s' "$tab_json" \
                | jq -r '.result.root_pane.pane_id // empty' 2>/dev/null)"
    if [ -n "$tab_pane" ]; then
      attach_member "$tab_pane"
    else
      # Couldn't read the tab's pane — fall back to the team layout rather than
      # spawning unpinned, which would land the member wherever focus happens
      # to be (and would be denied by the workspace guard anyway).
      printf 'claude-worktree: could not read the new tab pane id — falling back to a split off the lead pane\n' >&2
      start_member "$lead_pane" right
    fi ;;
  team|*)
    # team layout: leader = leftmost pane in this tab; members stack down the
    # right column. Read the geometry once, then open the column or stack under
    # it. Works from any pane (leader is spatial, not the pane you launched in).
    layout="$(herdr pane layout --pane "$lead_pane" 2>/dev/null || true)"
    leader="$(printf '%s' "$layout" \
      | jq -r '.result.layout.panes | sort_by(.rect.x, .rect.y) | .[0].pane_id // empty' 2>/dev/null)"
    if [ -z "$leader" ]; then
      start_member "$lead_pane" right               # can't read layout → best-effort
    else
      lx="$(printf '%s' "$layout" \
        | jq -r '.result.layout.panes | sort_by(.rect.x, .rect.y) | .[0].rect.x // 0' 2>/dev/null)"
      bottom="$(printf '%s' "$layout" | jq -r --argjson lx "${lx:-0}" \
        '.result.layout.panes | map(select(.rect.x > $lx)) | sort_by(.rect.y) | last | .pane_id // empty' 2>/dev/null)"
      if [ -z "$bottom" ]; then
        start_member "$leader" right                # no right column yet → open it
      else
        start_member "$bottom" down                 # stack under the column bottom
      fi
    fi ;;
esac

# land focus where the user wants it (default: the team leader, so you keep
# orchestrating from the left rather than being yanked into each new member).
case "$focus_mode" in
  member)
    # 0.9.0 creates every pane --no-focus, so --focus-member is landed here.
    # `agent focus` (not `pane focus`, which moves focus by DIRECTION) takes the
    # pane id hosting the agent.
    if [ -n "$member_pane" ]; then
      herdr agent focus "$member_pane" >/dev/null 2>&1 || true
    fi ;;
  none)
    if [ -n "$origin" ]; then
      herdr agent focus "$origin" >/dev/null 2>&1 || true
    fi ;;
  leader|*)
    ftarget="${leader:-$origin}"
    if [ -n "$ftarget" ]; then
      herdr agent focus "$ftarget" >/dev/null 2>&1 || true
    fi ;;
esac
printf 'launched claude "%s" in %s (branch "%s")\n' "$label" "$wt_path" "$branch"
