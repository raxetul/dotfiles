#!/usr/bin/env bash
# scripts/update-dotfiles — refresh everything this repo manages.
#
# Two layers, both idempotent and runnable independently:
#
#   packages       — git pull, brew update + bundle + cleanup on macOS,
#                    distro install on Linux (apt/pacman/dnf + AUR/Snap).
#   configurations — symlink check, lefthook hooks, bat cache,
#                    tmux/nvim/atuin reloads where applicable.
#
# Defaults to running both layers in order. Each step prints its own
# "==> stage" banner; on failure the script exits non-zero.
#
# Usage:
#   scripts/update-dotfiles                          # both layers
#   scripts/update-dotfiles --dry-run                # print every command, run none
#   scripts/update-dotfiles --yes                    # skip the git-pull confirmation
#   scripts/update-dotfiles --desktop                # include Linux desktop list
#   scripts/update-dotfiles --only=packages          # packages layer only
#   scripts/update-dotfiles --only=configurations    # configurations layer only
#   scripts/update-dotfiles --only=symlinks          # symlinks stage only
#                                                    # (re-link newly added configs)
#   scripts/update-dotfiles --only=custom-install        # both before.sh + after.sh hooks
#   scripts/update-dotfiles --only=custom-install-before # only before.sh hooks
#   scripts/update-dotfiles --only=custom-install-after  # only after.sh hooks
#
# Exit codes:
#   0   success
#   1   bad CLI arg, missing dependency, or a stage failed
set -euo pipefail

DRY_RUN=0
YES=0
DESKTOP=0
ONLY=""

for arg in "$@"; do
    case "${arg}" in
        --dry-run)             DRY_RUN=1 ;;
        --yes|-y)              YES=1 ;;
        --desktop)             DESKTOP=1 ;;
        --only=packages)              ONLY="packages" ;;
        --only=configurations)        ONLY="configurations" ;;
        --only=symlinks)              ONLY="symlinks" ;;
        --symlinks)                   ONLY="symlinks" ;;
        --only=custom-install)        ONLY="custom-install" ;;
        --only=custom-install-before) ONLY="custom-install-before" ;;
        --only=custom-install-after)  ONLY="custom-install-after" ;;
        --only=*)
            echo "Unknown --only value: ${arg#--only=}" >&2
            echo "Valid: packages, configurations, symlinks, custom-install," >&2
            echo "       custom-install-before, custom-install-after" >&2
            exit 1
            ;;
        -h|--help)
            sed -n '2,26p' "$0"
            exit 0
            ;;
        *)
            echo "Unknown argument: ${arg}" >&2
            exit 1
            ;;
    esac
done

# Scripts in this repo are installed onto PATH via the `scripts::.scripts`
# symlink in scripts/symlinks.sh — so `$0` resolves to ~/.scripts/... when
# invoked from PATH, and `dirname $0/..` would point at $HOME. The repo
# location is exported by configurations/{zsh,bash}/rc as $DOTFILES_DIR;
# fall back to the documented default if it's missing (cron, fresh shell).
REPO_ROOT="${DOTFILES_DIR:-${HOME}/gel-ort/dotfiles}"
[ -d "${REPO_ROOT}" ] || { printf 'ERR: repo not found at %s — set DOTFILES_DIR.\n' "${REPO_ROOT}" >&2; exit 1; }
cd "${REPO_ROOT}"

# Session log — every line printed from here on goes to the terminal
# AND to ~/.local/state/dotfiles/update-dotfiles.log via tee. The
# per-hook log at custom-install.log still gets the inner before/after
# script output (written by scripts/run-custom-install-hook); this
# session log captures the whole run including git-pull, brew/native
# install, fallbacks, and the configurations layer.
LOG_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/dotfiles"
LOG_FILE="${LOG_DIR}/update-dotfiles.log"
mkdir -p "${LOG_DIR}"
exec > >(tee -a "${LOG_FILE}") 2>&1
printf '\n==== %s update-dotfiles  only=%s dry-run=%s desktop=%s ====\n' \
    "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "${ONLY:-both}" "${DRY_RUN}" "${DESKTOP}"
_log_session_end() {
    local rc=$?
    printf '==== %s update-dotfiles end rc=%d ====\n\n' \
        "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "${rc}"
}
trap _log_session_end EXIT

# Ensure the gitignored .load file exists. It's sourced by
# configurations/{zsh,bash}/rc and in turn sources .path.
DOTFILES_DIR="${REPO_ROOT}" init-load

note()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
fail()  { printf '\033[1;31mERR:\033[0m  %s\n' "$*" >&2; exit 1; }

# do_or_say <command...> — execute, or echo a "[dry-run]" preview.
do_or_say() {
    if [ "${DRY_RUN}" -eq 1 ]; then
        printf '   [dry-run] would: %s\n' "$*"
    else
        "$@"
    fi
}

# do_or_say_sh '<single shell snippet>' — like do_or_say but for snippets
# that depend on shell syntax (pipes, redirects). Treated as one logical
# step from the dry-run printer's perspective.
do_or_say_sh() {
    if [ "${DRY_RUN}" -eq 1 ]; then
        printf '   [dry-run] would (sh): %s\n' "$*"
    else
        sh -c "$*"
    fi
}

# apt_keep_installable <pkgs...> — echo only packages that have an install
# candidate on this release, logging each skip. apt-get install is
# all-or-nothing, so one version-gated name (rust-analyzer / mold on older
# Ubuntu/Debian) would otherwise abort the whole batch. Needs the apt cache,
# refreshed by the update_cmd run just before.
apt_keep_installable() {
    local p cand keep=()
    for p in "$@"; do
        cand="$(apt-cache policy "${p}" 2>/dev/null \
                | awk -F': ' '/Candidate:/{print $2; exit}')"
        if [ -n "${cand}" ] && [ "${cand}" != "(none)" ]; then
            keep+=("${p}")
        else
            # Log to stderr: this function's stdout is captured by the
            # caller's `pkgs="$(apt_keep_installable …)"` command
            # substitution, so any skip text on stdout would be fed
            # straight into `apt-get install` as bogus package names.
            printf '   skip (no apt candidate on this release): %s\n' "${p}" >&2
        fi
    done
    printf '%s ' "${keep[@]}"
}

run_stage() {
    local name="$1"; shift
    note "stage: ${name}"
    if ! "$@"; then
        fail "stage ${name} failed"
    fi
}

# ----------------------------------------------------------------------
# Packages layer
# ----------------------------------------------------------------------

stage_packages_git_pull() {
    note "git pull --rebase"
    if [ "${YES}" -ne 1 ] && [ "${DRY_RUN}" -ne 1 ]; then
        # Confirm before pulling because pull can rewrite the working
        # tree (rebase, autostash). --yes bypasses for unattended runs.
        printf '   pull origin and rebase local commits? [y/N] '
        read -r ans
        case "${ans}" in
            y|Y|yes) ;;
            *) note "   skipped on user request"; return 0 ;;
        esac
    fi
    do_or_say git pull --rebase
}

stage_packages_brew() {
    if [ "$(uname)" != "Darwin" ]; then
        return 0
    fi
    if ! command -v brew >/dev/null 2>&1; then
        warn "brew not on PATH; skipping Brewfile replay"
        return 0
    fi
    note "brew update / upgrade / bundle / cleanup"
    do_or_say brew update
    do_or_say brew upgrade
    do_or_say brew bundle --file "${REPO_ROOT}/packages/Brewfile"
    do_or_say brew cleanup
}

stage_packages_native_linux() {
    if [ "$(uname)" != "Linux" ] || [ ! -f /etc/os-release ]; then
        return 0
    fi
    # shellcheck source=/dev/null
    . /etc/os-release
    local install_cmd update_cmd upgrade_cmd baseline desktop_list pkg_kind
    case "${ID:-}" in
        debian|ubuntu|pop|linuxmint)
            update_cmd="sudo apt-get update"
            upgrade_cmd="sudo apt-get upgrade -y"
            install_cmd="sudo apt-get install -y"
            baseline="${REPO_ROOT}/packages/apt.list"
            desktop_list="${REPO_ROOT}/packages/apt-desktop.list"
            pkg_kind="apt"
            ;;
        arch|manjaro|endeavouros|artix)
            update_cmd="sudo pacman -Syy --noconfirm"
            upgrade_cmd="sudo pacman -Syu --noconfirm"
            install_cmd="sudo pacman -S --needed --noconfirm"
            baseline="${REPO_ROOT}/packages/pacman.list"
            desktop_list="${REPO_ROOT}/packages/pacman-desktop.list"
            pkg_kind="pacman"
            ;;
        fedora|rhel|centos|almalinux|rocky)
            update_cmd="sudo dnf check-update || true"
            upgrade_cmd="sudo dnf upgrade -y"
            install_cmd="sudo dnf install -y"
            baseline="${REPO_ROOT}/packages/dnf.list"
            desktop_list="${REPO_ROOT}/packages/dnf-desktop.list"
            pkg_kind="dnf"
            ;;
        *)
            note "distro ${ID:-unknown} not mapped; skipping native update"
            return 0
            ;;
    esac

    do_or_say_sh "${update_cmd}"
    do_or_say_sh "${upgrade_cmd}"

    local lists=("${baseline}")
    [ "${DESKTOP}" -eq 1 ] && lists+=("${desktop_list}")
    for list in "${lists[@]}"; do
        [ -f "${list}" ] || continue
        local pkgs
        # Strip full-line AND inline `# …` comments, then blank lines.
        pkgs="$(sed -E 's/[[:space:]]*#.*$//' "${list}" \
                | grep -vE '^\s*$' | tr '\n' ' ')"
        # On apt, prune entries with no candidate so the batch survives.
        if [ "${pkg_kind}" = "apt" ] && [ -n "${pkgs}" ]; then
            # shellcheck disable=SC2086
            pkgs="$(apt_keep_installable ${pkgs})"
        fi
        if [ -n "${pkgs}" ]; then
            note "installing from ${list##*/}"
            # shellcheck disable=SC2086
            do_or_say ${install_cmd} ${pkgs}
        fi
    done
}

stage_packages_linux_fallback() {
    if [ "$(uname)" != "Linux" ] || [ ! -f /etc/os-release ]; then
        return 0
    fi
    # shellcheck source=/dev/null
    . /etc/os-release
    case "${ID:-}" in
        arch|manjaro|endeavouros|artix)
            local aur_list="${REPO_ROOT}/packages/aur.list"
            if [ -f "${aur_list}" ] && command -v yay >/dev/null 2>&1; then
                local pkgs
                pkgs="$(grep -vE '^\s*(#|$)' "${aur_list}" | tr '\n' ' ')"
                if [ -n "${pkgs}" ]; then
                    note "AUR install via yay"
                    # shellcheck disable=SC2086
                    do_or_say yay -S --needed --noconfirm ${pkgs}
                fi
            fi
            ;;
        debian|ubuntu|pop|linuxmint|fedora|rhel|centos|almalinux|rocky)
            local snap_list="${REPO_ROOT}/packages/snap.list"
            if [ -f "${snap_list}" ] && command -v snap >/dev/null 2>&1; then
                while IFS= read -r line; do
                    case "${line}" in ""|"#"*) continue ;; esac
                    note "snap install ${line}"
                    # shellcheck disable=SC2086
                    do_or_say sudo snap install ${line}
                done < "${snap_list}"
            fi
            ;;
    esac
}

# Walk packages/custom-install/<pkg>/ in lexical order. Print a single
# grouped banner per phase (start + listed pkgs + end) so the terminal
# output stays compact regardless of how many packages exist. Each
# script's output prints after the closing banner.
#
#   custom-install befores ---------------- start
#     rustup
#     foo
#   custom-install befores ---------------- end
#
#   (script outputs)
_run_custom_install_hooks() {
    local hook="$1"           # before | after
    local plural="${hook}s"   # befores | afters
    local root="${REPO_ROOT}/packages/custom-install"
    [ -d "${root}" ] || return 0
    local pkg_dir pkg
    local pkgs=()
    for pkg_dir in "${root}"/*/; do
        [ -d "${pkg_dir}" ] || continue
        pkgs+=("$(basename "${pkg_dir}")")
    done
    [ "${#pkgs[@]}" -eq 0 ] && return 0
    printf 'custom-install %s ---------------- start\n' "${plural}"
    printf '  %s\n' "${pkgs[@]}"
    printf 'custom-install %s ---------------- end\n\n' "${plural}"
    for pkg in "${pkgs[@]}"; do
        DRY_RUN="${DRY_RUN}" do_or_say run-custom-install-hook "${pkg}" "${hook}"
    done
}

stage_packages_custom_before() { _run_custom_install_hooks before; }
stage_packages_custom_after()  { _run_custom_install_hooks after;  }

run_packages() {
    run_stage "git-pull"        stage_packages_git_pull
    run_stage "custom-before"   stage_packages_custom_before
    run_stage "brew"            stage_packages_brew
    run_stage "native-linux"    stage_packages_native_linux
    run_stage "linux-fallback"  stage_packages_linux_fallback
    run_stage "custom-after"    stage_packages_custom_after
}

# ----------------------------------------------------------------------
# Configurations layer
# ----------------------------------------------------------------------

stage_configurations_symlinks() {
    note "symlinks.sh install"
    [ "${DESKTOP}" -eq 1 ] && export DOTFILES_DESKTOP=1
    do_or_say symlinks.sh install
}

stage_configurations_lefthook() {
    if ! command -v lefthook >/dev/null 2>&1; then
        warn "lefthook not on PATH; skipping hook refresh"
        return 0
    fi
    note "lefthook install"
    do_or_say lefthook install
    note "lefthook run pre-commit --all-files"
    do_or_say lefthook run pre-commit --all-files
}

stage_configurations_bat_cache() {
    if ! command -v bat >/dev/null 2>&1; then
        return 0
    fi
    note "bat cache --build"
    do_or_say bat cache --build
}

stage_configurations_tmux_reload() {
    # Best-effort: only meaningful if a tmux server is actually running.
    if ! command -v tmux >/dev/null 2>&1; then
        return 0
    fi
    if ! tmux info >/dev/null 2>&1; then
        return 0
    fi
    note "tmux source-file ~/.config/tmux/tmux.conf"
    do_or_say tmux source-file "${HOME}/.config/tmux/tmux.conf" || \
        warn "tmux source-file failed (non-fatal)"
}

# Reconcile TPM against tmux.conf (CLAUDE.md §14): tmux.conf's `@plugin`
# lines are the source of truth — install_plugins adds the declared ones,
# clean_plugins removes any checkout no longer declared (e.g. resurrect /
# continuum after they were dropped from the config).
stage_configurations_tpm() {
    local bin="${HOME}/.config/tmux/plugins/tpm/bin"
    if [ ! -x "${bin}/install_plugins" ]; then
        return 0
    fi
    note "tpm install_plugins (headless)"
    do_or_say "${bin}/install_plugins" || warn "tpm install_plugins failed (non-fatal)"
    note "tpm clean_plugins (prune undeclared)"
    do_or_say "${bin}/clean_plugins" || warn "tpm clean_plugins failed (non-fatal)"
}

# Reconcile vim-plug against vimrc (CLAUDE.md §14): `Plug` directives are the
# source of truth — PlugInstall adds the declared ones, PlugClean! (the `!`
# skips the interactive confirm) removes any plugin dir no longer declared.
stage_configurations_vim_plug() {
    if ! command -v vim >/dev/null 2>&1; then
        return 0
    fi
    note "vim +PlugInstall +PlugClean! +qa --headless"
    do_or_say_sh "vim +PlugInstall +PlugClean! +qa --headless 2>/dev/null || true"
}

stage_configurations_atuin_daemon() {
    if ! command -v atuin >/dev/null 2>&1; then
        return 0
    fi
    if ! atuin --help 2>&1 | grep -q '^[[:space:]]*daemon'; then
        return 0
    fi
    note "atuin daemon restart"
    do_or_say_sh "atuin daemon restart >/dev/null 2>&1 || true"
}

run_configurations() {
    run_stage "symlinks"        stage_configurations_symlinks
    run_stage "lefthook"        stage_configurations_lefthook
    run_stage "bat-cache"       stage_configurations_bat_cache
    run_stage "tmux-reload"     stage_configurations_tmux_reload
    run_stage "tpm"             stage_configurations_tpm
    run_stage "vim-plug"        stage_configurations_vim_plug
    run_stage "atuin-daemon"    stage_configurations_atuin_daemon
}

# ----------------------------------------------------------------------
# Dispatch
# ----------------------------------------------------------------------

note "update-dotfiles  (dry-run=${DRY_RUN}, yes=${YES}, desktop=${DESKTOP}, only=${ONLY:-both})"
note "repo: ${REPO_ROOT}"
echo

case "${ONLY}" in
    packages)                run_packages ;;
    configurations)          run_configurations ;;
    symlinks)                run_stage "symlinks"      stage_configurations_symlinks ;;
    custom-install-before)   run_stage "custom-before" stage_packages_custom_before ;;
    custom-install-after)    run_stage "custom-after"  stage_packages_custom_after ;;
    custom-install)
        run_stage "custom-before" stage_packages_custom_before
        run_stage "custom-after"  stage_packages_custom_after
        ;;
    "")                      run_packages; echo; run_configurations ;;
esac

echo
note "done."
